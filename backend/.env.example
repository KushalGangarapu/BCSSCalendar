# Database Connection URL (e.g., Supabase PostgreSQL or local SQLite)
DATABASE_URL="postgresql://username:password@host:port/database"

# Secret key for signing JWT tokens (use a long, secure random string in production)
JWT_SECRET="your-jwt-secret-key"

# Port number for the backend server
PORT=3001

# URL of the frontend client (for CORS configuration)
FRONTEND_URL="http://localhost:5173"
